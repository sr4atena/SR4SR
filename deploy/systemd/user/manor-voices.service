[Unit]
Description=Manor Ledger: read YouTube, summarise it, publish to the server
Documentation=file:///home/sr/SR4SR/docs/PLAN-voices.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/SR4SR
Environment=MANOR_DATA_DIR=%h/SR4SR/data

# This job deliberately runs here and not on the server: YouTube refuses
# caption requests from datacenter addresses, so the extraction has to happen
# from a residential connection. The server only serves what this publishes.
ExecStart=/opt/lampp/bin/php bin/voices
ExecStart=/bin/bash bin/voices-publish

# The run paces itself against YouTube at one caption request every two
# minutes, so give it room rather than killing it: fifteen uncached videos
# with retries still fit.
TimeoutStartSec=120min
Nice=10
